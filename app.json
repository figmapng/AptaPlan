{
  "expo": {
    "name": "AptaPlan",
    "slug": "aptaplan",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "aptaplan",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "remindersPermission": "Тапсырмаларды Apple Reminders қосымшасынан AptaPlan-ға импорттау үшін рұқсат қажет."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nurserikz.aptaplan",
      "buildNumber": "1",
      "infoPlist": {
        "NSRemindersUsageDescription": "Тапсырмаларды Apple Reminders қосымшасынан AptaPlan-ға импорттау үшін рұқсат қажет.",
        "NSRemindersFullAccessUsageDescription": "Тапсырмаларды Apple Reminders қосымшасынан AptaPlan-ға импорттау үшін рұқсат қажет.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.nurserikz.aptaplan",
      "versionCode": 1
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d981943-e979-4edd-92e2-4c923bf4d05a"
      }
    },
    "owner": "nurserikz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4d981943-e979-4edd-92e2-4c923bf4d05a"
    },
    "locales": {
      "kk": "./locales/kk.json",
      "ru": "./locales/ru.json",
      "en": "./locales/en.json"
    }
  }
}
