{
  "expo": {
    "name": "AptaPlan",
    "slug": "aptaplan",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "aptaplan",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-sqlite", "expo-notifications"],
    "ios": { "supportsTablet": true },
    "android": { "edgeToEdgeEnabled": true },
    "experiments": { "typedRoutes": true }
  }
}
